<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>PackageConsumer</RootNamespace>
    <AssemblyName>Community.Phone.Controls.Toolkit.WPF.PackageConsumer</AssemblyName>
    <ToolkitVersion Condition="'$(ToolkitVersion)' == ''">0.1.0-preview.1</ToolkitVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Community.Phone.Controls.Toolkit.WPF" Version="$(ToolkitVersion)" />
  </ItemGroup>

</Project>
