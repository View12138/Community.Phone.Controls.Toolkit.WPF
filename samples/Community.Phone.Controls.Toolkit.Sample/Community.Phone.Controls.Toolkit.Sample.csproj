<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<RootNamespace>PhoneToolkitSample</RootNamespace>
		<AssemblyName>Community.Phone.Controls.Toolkit.Sample</AssemblyName>
		<StartupObject>PhoneToolkitSample.App</StartupObject>
		<NoWarn>$(NoWarn);CS1591;CS0618;CS0612;CA1416;CA1507;CA1510;CA1512;CA2263</NoWarn>
		<NoWarn>$(NoWarn);IDE0017;IDE0130;IDE0290;IDE0090;IDE0300</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Community.Phone\Community.Phone.csproj" />
		<ProjectReference Include="..\..\src\Community.Phone.Controls.Toolkit\Community.Phone.Controls.Toolkit.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Images\*.png" />
		<Resource Include="Images\*.jpg" />
		<Resource Include="Data\LoremIpsum.txt" />
		<Compile Update="Resources\AppResources.Designer.cs">
		  <DesignTime>True</DesignTime>
		  <AutoGen>True</AutoGen>
		  <DependentUpon>AppResources.resx</DependentUpon>
		</Compile>
		<EmbeddedResource Update="Resources\AppResources.resx">
		  <Generator>ResXFileCodeGenerator</Generator>
		  <LastGenOutput>AppResources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<Page Update="Themes\Generic.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
	</ItemGroup>

</Project>
