<platform:PhoneApplicationPage
    x:Class="PhoneToolkitSample.Pages.WPFControlsSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Community.Phone.Controls.Toolkit"
    xmlns:platform="clr-namespace:Microsoft.Phone.Controls;assembly=Community.Phone"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{DynamicResource PhoneForegroundBrush}">

    <Grid Background="{DynamicResource PhoneBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="12,24,12,12">
            <TextBlock Text="Community Phone Toolkit" Style="{StaticResource PhoneTextNormalStyle}" />
            <TextBlock Text="controls" Style="{StaticResource PhoneTextTitle1Style}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,0,12,24">
                <TextBlock Text="WPF base controls" Style="{StaticResource PhoneTextAccentStyle}" />
                <Button Content="Accent button" Margin="0,8,0,8" phone:TiltEffect.IsTiltEnabled="True" />
                <TextBox Text="Editable WPF TextBox" Margin="0,0,0,8" />
                <ComboBox SelectedIndex="0" Margin="0,0,0,8">
                    <ComboBoxItem Content="ComboBox item A" />
                    <ComboBoxItem Content="ComboBox item B" />
                    <ComboBoxItem Content="ComboBox item C" />
                </ComboBox>
                <CheckBox Content="CheckBox" IsChecked="True" Margin="0,0,0,8" />
                <RadioButton GroupName="SampleRadio" Content="RadioButton A" IsChecked="True" Margin="0,0,0,4" />
                <RadioButton GroupName="SampleRadio" Content="RadioButton B" Margin="0,0,0,12" />
                <ListBox Height="112" Margin="0,0,0,16">
                    <ListBoxItem Content="ListBox item one" />
                    <ListBoxItem Content="ListBox item two" />
                    <ListBoxItem Content="ListBox item three" />
                </ListBox>
                <phone:WrapPanel Margin="0,0,0,16">
                    <Button Content="WrapPanel 1" Margin="0,0,8,8" />
                    <Button Content="WrapPanel 2" Margin="0,0,8,8" />
                    <Button Content="WrapPanel 3" Margin="0,0,8,8" />
                </phone:WrapPanel>

                <TextBlock Text="Toolkit controls" Style="{StaticResource PhoneTextAccentStyle}" />
                <phone:ToggleSwitch Header="Wi-Fi networking" Margin="0,8,0,8" />
                <phone:Rating
                    x:Name="DemoRating"
                    Width="220"
                    Height="44"
                    Value="3"
                    AllowHalfItemIncrement="True"
                    Margin="0,8,0,8"
                    ValueChanged="OnRatingValueChanged" />
                <TextBlock x:Name="RatingStatus" Text="Rating: 3.0" Style="{StaticResource PhoneTextSubtleStyle}" Margin="0,0,0,8" />
                <phone:PhoneTextBox
                    Hint="Type something"
                    LengthIndicatorVisible="True"
                    LengthIndicatorThreshold="0"
                    MaxLength="100"
                    Margin="0,0,0,16" />
                <phone:ListPicker Header="Transition family" x:Name="Picker" Margin="0,0,0,16">
                    <sys:String>Turnstile</sys:String>
                    <sys:String>Slide</sys:String>
                    <sys:String>Rotate</sys:String>
                </phone:ListPicker>
                <phone:RecurringDaysPicker Header="Repeats" Margin="0,0,0,16" />
                <phone:ExpanderView Header="ExpanderView" Margin="0,0,0,16">
                    <TextBlock Text="Expanded content" Margin="0,8,0,0" />
                    <TextBlock Text="Second item" Margin="0,8,0,0" />
                </phone:ExpanderView>
                <phone:DatePicker Header="Date" Margin="0,0,0,12" />
                <phone:TimePicker Header="Time" Margin="0,0,0,16" />
                <phone:PerformanceProgressBar IsIndeterminate="True" Margin="0,0,0,16" />
                <phone:RelativeAnimatingContentControl Margin="0,0,0,16">
                    <TextBlock Text="RelativeAnimatingContentControl content" Style="{StaticResource PhoneTextNormalStyle}" />
                </phone:RelativeAnimatingContentControl>
                <phone:HubTile Title="HubTile" Message="Back side" DisplayNotification="False" HorizontalAlignment="Left" Margin="0,0,0,16" />

                <Button Content="Go back" Click="OnGoBack" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</platform:PhoneApplicationPage>
