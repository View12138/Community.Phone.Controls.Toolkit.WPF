<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Primitives="clr-namespace:Microsoft.Phone.Controls.Primitives"
    xmlns:System="clr-namespace:System;assembly=System.Runtime"
    xmlns:controls="clr-namespace:Microsoft.Phone.Controls"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls"
    xmlns:wpf="clr-namespace:System.Windows;assembly=PresentationFramework">

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource PhoneTextBoxBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PhoneTextBoxForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PhoneTextBoxBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PhoneBorderThickness}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontFamily" Value="{DynamicResource PhoneFontFamilyNormal}" />
        <Setter Property="FontSize" Value="{DynamicResource PhoneFontSizeMediumLarge}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PhoneForegroundBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource PhoneAccentBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border
                        x:Name="TextBoxRoot"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Auto" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="TextBoxRoot" Property="BorderBrush" Value="{DynamicResource PhoneAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TextBoxRoot" Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="TextBoxRoot" Property="Background" Value="{DynamicResource PhoneChromeBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>