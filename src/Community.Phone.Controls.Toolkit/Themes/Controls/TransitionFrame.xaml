<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Primitives="clr-namespace:Microsoft.Phone.Controls.Primitives"
    xmlns:System="clr-namespace:System;assembly=System.Runtime"
    xmlns:controls="clr-namespace:Microsoft.Phone.Controls"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls"
    xmlns:wpf="clr-namespace:System.Windows;assembly=PresentationFramework"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell">


    <!--  Phone frame templates.  -->
    <Style TargetType="{x:Type phone:PhoneApplicationFrame}">
        <Setter Property="Background" Value="{DynamicResource PhoneBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PhoneForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type phone:PhoneApplicationFrame}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ContentPresenter
                            Grid.Row="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <!--  Reserves room for the page application bar; a floating bar draws outside of it.  -->
                        <Grid
                            x:Name="ApplicationBarHost"
                            Grid.Row="1"
                            Height="0"
                            ClipToBounds="False">
                            <shell:ApplicationBarPresenter x:Name="ApplicationBar" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type phone:TransitionFrame}">
        <Setter Property="Background" Value="{DynamicResource PhoneBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PhoneForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type phone:TransitionFrame}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <phone:ProjectionHost
                            x:Name="FirstContentPresenter"
                            Grid.Row="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
                        <phone:ProjectionHost
                            x:Name="SecondContentPresenter"
                            Grid.Row="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
                        <!--  Reserves room for the page application bar; a floating bar draws outside of it.  -->
                        <Grid
                            x:Name="ApplicationBarHost"
                            Grid.Row="1"
                            Height="0"
                            ClipToBounds="False">
                            <shell:ApplicationBarPresenter x:Name="ApplicationBar" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>