<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<OutputType>Library</OutputType>
		<AssemblyName>Community.Phone.Controls.Toolkit.WPF</AssemblyName>
		<RootNamespace>Microsoft.Phone.Controls</RootNamespace>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591;CS0618;CS0612;CA1416;CA1507;CA1510;CA1512;CA2263</NoWarn>
		<NoWarn>$(NoWarn);IDE0017;IDE0028;IDE0130;IDE0290;IDE0090;IDE0300</NoWarn>
		<EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
		<PackageId>Community.Phone.Controls.Toolkit.WPF</PackageId>
		<Title>Community Windows Phone Toolkit for WPF</Title>
		<Description>WPF compatibility port of the archived Windows Phone Toolkit. Provides Metro-styled controls, PlaneProjection-compatible 3D projection, navigation transitions, and phone application infrastructure for modern WPF.</Description>
		<PackageTags>WPF;WindowsPhone;Toolkit;Metro;Controls;Transitions;Projection</PackageTags>
		<PackageLicenseExpression>MS-PL</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryType>git</RepositoryType>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\packages</PackageOutputPath>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<EnablePackageValidation>false</EnablePackageValidation>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RootNamespace>Microsoft.Phone.Controls</RootNamespace>
	</PropertyGroup>

	<PropertyGroup>
		<!--
			The port keeps the original toolkit sources, which branch on
			WINDOWS_PHONE to select the compatible namespaces and the localized
			resources. Both configurations must define it: Release used to omit
			it and failed to compile LengthConverter, TypeConverters,
			RoutedPropertyChangingEventArgs and InteractionHelper.
		-->
		<DefineConstants>$(DefineConstants);WINDOWS_PHONE;WP8</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\README_zh-CN.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
		<None Include="..\..\THIRD-PARTY-NOTICES.md" Link="Properties\docs\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
		<None Include="..\..\THIRD-PARTY-NOTICES_zh-CN.md" Link="Properties\docs\THIRD-PARTY-NOTICES_zh-CN.md" Pack="true" PackagePath="\" />
		<None Include="..\..\docs\en\*.md" Link="Properties\docs\en\%(Filename)%(Extension)" Pack="true" PackagePath="docs\en\" />
		<None Include="..\..\docs\zh-CN\*.md" Link="Properties\docs\zh-CN\%(Filename)%(Extension)" Pack="true" PackagePath="docs\zh-CN\" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Content\*.png" />
	</ItemGroup>

	<ItemGroup>
		<Page Update="Themes\Theme\DarkCobalt.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
		<Page Update="Themes\Controls\*.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
		<Page Update="Themes\Generic.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
	</ItemGroup>


	<ItemGroup>
		<None Remove="Transitions\Storyboards\Roll.xaml" />
		<None Remove="Transitions\Storyboards\RotateOut180Clockwise.xaml" />
		<None Remove="Transitions\Storyboards\RotateOut180CounterClockwise.xaml" />
		<None Remove="Transitions\Storyboards\RotateOut90Clockwise.xaml" />
		<None Remove="Transitions\Storyboards\RotateOut90CounterClockwise.xaml" />
		<None Remove="Transitions\Storyboards\SlideDownFadeIn.xaml" />
		<None Remove="Transitions\Storyboards\SlideUpFadeOut.xaml" />
		<None Remove="Transitions\Storyboards\SwivelBackwardIn.xaml" />
		<None Remove="Transitions\Storyboards\SwivelBackwardOut.xaml" />
		<None Remove="Transitions\Storyboards\RotateIn180Clockwise.xaml" />
		<None Remove="Transitions\Storyboards\RotateIn90Clockwise.xaml" />
		<None Remove="Transitions\Storyboards\RotateIn180CounterClockwise.xaml" />
		<None Remove="Transitions\Storyboards\RotateIn90CounterClockwise.xaml" />
		<None Remove="Transitions\Storyboards\SlideRightFadeOut.xaml" />
		<None Remove="Transitions\Storyboards\SlideRightFadeIn.xaml" />
		<None Remove="Transitions\Storyboards\SlideLeftFadeOut.xaml" />
		<None Remove="Transitions\Storyboards\SlideLeftFadeIn.xaml" />
		<None Remove="Transitions\Storyboards\SlideDownFadeOut.xaml" />
		<None Remove="Transitions\Storyboards\SlideUpFadeIn.xaml" />
		<None Remove="Transitions\Storyboards\SwivelFullScreenOut.xaml" />
		<None Remove="Transitions\Storyboards\SwivelForwardOut.xaml" />
		<None Remove="Transitions\Storyboards\TurnstileForwardOut.xaml" />
		<None Remove="Transitions\Storyboards\TurnstileForwardIn.xaml" />
		<None Remove="Transitions\Storyboards\TurnstileBackwardIn.xaml" />
		<None Remove="Transitions\Storyboards\TurnstileBackwardOut.xaml" />
		<None Remove="Transitions\Storyboards\SwivelForwardIn.xaml" />
		<None Remove="Transitions\Storyboards\SwivelFullScreenIn.xaml" />
	</ItemGroup>
	<ItemGroup>
		<Resource Include="Transitions\Storyboards\Roll.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Resource>
		<Resource Include="Transitions\Storyboards\RotateOut180Clockwise.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
		<Resource Include="Transitions\Storyboards\RotateOut180CounterClockwise.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
		<Resource Include="Transitions\Storyboards\RotateOut90Clockwise.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
		<Resource Include="Transitions\Storyboards\RotateOut90CounterClockwise.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
		<Resource Include="Transitions\Storyboards\SlideDownFadeIn.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
		<Resource Include="Transitions\Storyboards\SlideUpFadeOut.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
		<Resource Include="Transitions\Storyboards\SwivelBackwardIn.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
		<Resource Include="Transitions\Storyboards\SwivelBackwardOut.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
		<Resource Include="Transitions\Storyboards\RotateIn180Clockwise.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
		<Resource Include="Transitions\Storyboards\RotateIn90Clockwise.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
		<Resource Include="Transitions\Storyboards\RotateIn180CounterClockwise.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
		<Resource Include="Transitions\Storyboards\RotateIn90CounterClockwise.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
		<Resource Include="Transitions\Storyboards\SlideRightFadeOut.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
		<Resource Include="Transitions\Storyboards\SlideRightFadeIn.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
		<Resource Include="Transitions\Storyboards\SlideLeftFadeOut.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
		<Resource Include="Transitions\Storyboards\SlideLeftFadeIn.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
		<Resource Include="Transitions\Storyboards\SlideDownFadeOut.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
		<Resource Include="Transitions\Storyboards\SlideUpFadeIn.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
		<Resource Include="Transitions\Storyboards\SwivelFullScreenOut.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
		<Resource Include="Transitions\Storyboards\SwivelForwardOut.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
		<Resource Include="Transitions\Storyboards\TurnstileForwardOut.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
		<Resource Include="Transitions\Storyboards\TurnstileForwardIn.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
		<Resource Include="Transitions\Storyboards\TurnstileBackwardIn.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
		<Resource Include="Transitions\Storyboards\TurnstileBackwardOut.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
		<Resource Include="Transitions\Storyboards\SwivelForwardIn.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
		<Resource Include="Transitions\Storyboards\SwivelFullScreenIn.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
	</ItemGroup>
	<ItemGroup>
	  <Compile Update="Properties\Resources.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Resources.resx</DependentUpon>
	  </Compile>
	</ItemGroup>
	<ItemGroup>
	  <EmbeddedResource Update="Properties\Resources.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>

</Project>
