<platform:PhoneApplicationPage
    x:Class="PhoneToolkitSample.Pages.FeatherPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Community.Phone.Controls.Toolkit"
    xmlns:platform="clr-namespace:Microsoft.Phone.Controls;assembly=Community.Phone"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}">

    <phone:TransitionService.NavigationInTransition>
        <phone:NavigationInTransition>
            <phone:NavigationInTransition.Forward>
                <phone:TurnstileFeatherTransition Mode="ForwardIn" />
            </phone:NavigationInTransition.Forward>
            <phone:NavigationInTransition.Backward>
                <phone:TurnstileFeatherTransition Mode="BackwardIn" />
            </phone:NavigationInTransition.Backward>
        </phone:NavigationInTransition>
    </phone:TransitionService.NavigationInTransition>

    <phone:TransitionService.NavigationOutTransition>
        <phone:NavigationOutTransition>
            <phone:NavigationOutTransition.Forward>
                <phone:TurnstileFeatherTransition Mode="ForwardOut" />
            </phone:NavigationOutTransition.Forward>
            <phone:NavigationOutTransition.Backward>
                <phone:TurnstileFeatherTransition Mode="BackwardOut" />
            </phone:NavigationOutTransition.Backward>
        </phone:NavigationOutTransition>
    </phone:TransitionService.NavigationOutTransition>

    <Grid Background="{StaticResource PhoneBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,24,12,12">
                <TextBlock
                    Text="feathering"
                    Style="{StaticResource PhoneTextTitle1Style}"
                    phone:TurnstileFeatherEffect.FeatheringIndex="1" />
                <TextBlock
                    Text="TurnstileFeatherEffect animates each element in a staggered sequence instead of rotating the whole page at once."
                    Style="{StaticResource PhoneTextNormalStyle}"
                    TextWrapping="Wrap"
                    Margin="0,12,0,12"
                    phone:TurnstileFeatherEffect.FeatheringIndex="2" />
                <TextBlock
                    Text="Element three"
                    Style="{StaticResource PhoneTextSubtleStyle}"
                    Margin="0,0,0,10"
                    phone:TurnstileFeatherEffect.FeatheringIndex="3" />
                <TextBlock
                    Text="Element four"
                    Style="{StaticResource PhoneTextSubtleStyle}"
                    Margin="0,0,0,10"
                    phone:TurnstileFeatherEffect.FeatheringIndex="4" />
                <TextBlock
                    Text="Element five"
                    Style="{StaticResource PhoneTextSubtleStyle}"
                    Margin="0,0,0,10"
                    phone:TurnstileFeatherEffect.FeatheringIndex="5" />
                <TextBlock
                    Text="Element six"
                    Style="{StaticResource PhoneTextSubtleStyle}"
                    Margin="0,0,0,24"
                    phone:TurnstileFeatherEffect.FeatheringIndex="6" />
                <Button Content="Go back" Click="OnGoBack" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</platform:PhoneApplicationPage>
