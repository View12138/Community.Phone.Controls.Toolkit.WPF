<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<OutputType>Library</OutputType>
		<Nullable>enable</Nullable>
		<AssemblyName>Community.Phone</AssemblyName>
		<RootNamespace>Microsoft.Phone</RootNamespace>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
		<IsPackable>false</IsPackable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup>
		<DefineConstants>$(DefineConstants);WINDOWS_PHONE;WP8</DefineConstants>
		<NoWarn>$(NoWarn);CS1591;CS0618;CS0612;CA1416;CA1507;CA1510;CA1512;CA2263</NoWarn>
		<NoWarn>$(NoWarn);IDE0017;IDE0028;IDE0130;IDE0290;IDE0090;IDE0300</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<Page Update="Themes\Generic.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
	</ItemGroup>

</Project>
