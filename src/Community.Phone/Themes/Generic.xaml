<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Microsoft.Phone.Controls"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell">
    
    <ResourceDictionary.MergedDictionaries>
        <!--  Single, persistent theme dictionary. Loaded once; Microsoft.Phone.Shell.ThemeManager recolors its brushes in place.  -->
        <ResourceDictionary Source="/Community.Phone;component/Themes/Theme.xaml" />

        <ResourceDictionary Source="/Community.Phone;component/Themes/Controls/Button.xaml" />
        <ResourceDictionary Source="/Community.Phone;component/Themes/Controls/ListBox.xaml" />
        <ResourceDictionary Source="/Community.Phone;component/Themes/Controls/LongListSelector.xaml" />
        <ResourceDictionary Source="/Community.Phone;component/Themes/Controls/PhoneApplicationFrame.xaml" />
        <ResourceDictionary Source="/Community.Phone;component/Themes/Controls/Pivot.xaml" />
        <ResourceDictionary Source="/Community.Phone;component/Themes/Controls/ScrollBar.xaml" />
        <ResourceDictionary Source="/Community.Phone;component/Themes/Controls/ScrollViewer.xaml" />
        <ResourceDictionary Source="/Community.Phone;component/Themes/Controls/TextBlock.xaml" />
        <ResourceDictionary Source="/Community.Phone;component/Themes/Controls/TextBox.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
