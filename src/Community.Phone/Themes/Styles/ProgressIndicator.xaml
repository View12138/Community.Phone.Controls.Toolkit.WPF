<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell">

    <Style TargetType="{x:Type shell:ProgressIndicatorPresenter}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shell:ProgressIndicatorPresenter}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ProgressBar
                            x:Name="PART_ProgressBar"
                            Background="{x:Null}"
                            Height="4"
                            Padding="0"
                            VerticalAlignment="Top" />
                        <TextBlock
                            x:Name="PART_Text"
                            Grid.Row="1"
                            HorizontalAlignment="Right"
                            Margin="0,2,12,0"
                            FontFamily="{DynamicResource PhoneFontFamilyNormal}"
                            FontSize="{DynamicResource PhoneFontSizeSmall}"
                            Foreground="{DynamicResource PhoneForegroundBrush}"
                            Visibility="Collapsed" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
