<Window
    x:Class="PhoneToolkitSample.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Community.Phone.Controls.Toolkit.WPF"
    Title="Community Phone Toolkit WPF Sample"
    Width="480"
    Height="800"
    Background="Black"
    ResizeMode="CanResizeWithGrip">
    <Grid>
        <phone:TransitionFrame x:Name="Frame" />
        <Button VerticalAlignment="Center" Content="asd" RenderTransformOrigin="0.5,0.5">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="48.576"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
            <!--<Button.RenderTransform>
                <RotateTransform3D>
                    <RotateTransform3D.Rotation>
                        <AxisAngleRotation3D x:Name="myAngleRotation" Axis="0,3,0" Angle="1" />
                    </RotateTransform3D.Rotation>
                </RotateTransform3D>
            </Button.RenderTransform>-->
        </Button>
    </Grid>
</Window>
