<Window
    x:Class="PhoneToolkitSample.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Community.Phone.Controls.Toolkit.WPF"
    Title="Community Phone Toolkit WPF Sample"
    Width="480"
    Height="800"
    Background="Black"
    ResizeMode="CanResizeWithGrip">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <phone:TransitionFrame x:Name="Frame" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                HorizontalAlignment="Center"
                BorderThickness="0"
                Click="Back_Button_Click"
                Content="&#xE72B;"
                FontFamily="{DynamicResource PhoneFontFamilySymbol}" />
            <Button
                Grid.Column="1"
                HorizontalAlignment="Center"
                BorderThickness="0"
                Click="Home_Button_Click"
                Content="&#xE80F;"
                FontFamily="{DynamicResource PhoneFontFamilySymbol}" />
            <Button
                Grid.Column="2"
                HorizontalAlignment="Center"
                BorderThickness="0"
                Click="Search_Button_Click"
                Content="&#xE721;"
                FontFamily="{DynamicResource PhoneFontFamilySymbol}" />
        </Grid>
    </Grid>
</Window>
