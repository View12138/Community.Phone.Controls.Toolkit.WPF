<phone:PhoneApplicationPage
    x:Class="PhoneToolkitSample.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Community.Phone.Controls.Toolkit.WPF"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Community.Phone.Controls.Toolkit.WPF"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    shell:SystemTray.IsVisible="True">

    <phone:TransitionService.NavigationInTransition>
        <phone:NavigationInTransition>
            <phone:NavigationInTransition.Backward>
                <phone:TurnstileTransition Mode="BackwardIn" />
            </phone:NavigationInTransition.Backward>
            <phone:NavigationInTransition.Forward>
                <phone:TurnstileTransition Mode="ForwardIn" />
            </phone:NavigationInTransition.Forward>
        </phone:NavigationInTransition>
    </phone:TransitionService.NavigationInTransition>

    <phone:TransitionService.NavigationOutTransition>
        <phone:NavigationOutTransition>
            <phone:NavigationOutTransition.Backward>
                <phone:TurnstileTransition Mode="BackwardOut" />
            </phone:NavigationOutTransition.Backward>
            <phone:NavigationOutTransition.Forward>
                <phone:TurnstileTransition Mode="ForwardOut" />
            </phone:NavigationOutTransition.Forward>
        </phone:NavigationOutTransition>
    </phone:TransitionService.NavigationOutTransition>

    <Grid Background="{StaticResource PhoneBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="12,24,12,12">
            <TextBlock Text="Community Phone Toolkit" Style="{StaticResource PhoneTextNormalStyle}" />
            <TextBlock Text="WPF port" Style="{StaticResource PhoneTextTitle1Style}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,0,12,24">
                <TextBlock Text="Projection" Style="{StaticResource PhoneTextAccentStyle}" />
                <phone:ProjectionHost x:Name="ProjectionDemo" Height="180" Margin="0,8,0,16">
                    <Border Background="{StaticResource PhoneAccentBrush}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="PlaneProjection" Foreground="White" FontSize="24" HorizontalAlignment="Center" />
                            <TextBlock Text="real Viewport2DVisual3D" Foreground="White" FontSize="14" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <phone:ProjectionHost.Projection>
                        <phone:PlaneProjection x:Name="DemoProjection" CenterOfRotationX="0.5" CenterOfRotationY="0.5" />
                    </phone:ProjectionHost.Projection>
                </phone:ProjectionHost>

                <Button Content="Open detail page (turnstile)" Click="OnOpenDetail" Margin="0,0,0,16" />
                <Button Content="Animate projection" Click="OnAnimateProjection" Margin="0,0,0,16" />

                <TextBlock Text="Controls" Style="{StaticResource PhoneTextAccentStyle}" />
                <phone:ToggleSwitch Header="Wi-Fi networking" Margin="0,8,0,8" />
                <phone:Rating Width="220" Height="44" Value="3" AllowHalfItemIncrement="True" Margin="0,8,0,16" />
                <phone:PhoneTextBox Hint="Type something" LengthIndicatorVisible="True" LengthIndicatorThreshold="0" MaxLength="100" Margin="0,0,0,16" />
                <phone:ListPicker Header="Transition family" x:Name="Picker" Margin="0,0,0,16">
                    <sys:String>Turnstile</sys:String>
                    <sys:String>Slide</sys:String>
                    <sys:String>Rotate</sys:String>
                </phone:ListPicker>
                <phone:ExpanderView Header="ExpanderView" Margin="0,0,0,16">
                    <TextBlock Text="Expanded content" Margin="0,8,0,0" />
                    <TextBlock Text="Second item" Margin="0,8,0,0" />
                </phone:ExpanderView>
                <phone:HubTile Title="HubTile" Message="Back side" DisplayNotification="False" HorizontalAlignment="Left" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</phone:PhoneApplicationPage>
