<phone:PhoneApplicationPage
    x:Class="PhoneToolkitSample.Pages.MenusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Community.Phone.Controls.Toolkit.WPF"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}">

    <Grid Background="{StaticResource PhoneBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="12,24,12,12">
            <TextBlock Text="Community Phone Toolkit" Style="{StaticResource PhoneTextNormalStyle}" />
            <TextBlock Text="menus and dialogs" Style="{StaticResource PhoneTextTitle1Style}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,0,12,24">
                <Border Background="{StaticResource PhoneChromeBrush}" Padding="12" Margin="0,0,0,16">
                    <phone:ContextMenuService.ContextMenu>
                        <phone:ContextMenu>
                            <phone:MenuItem Header="Copy" Click="OnContextMenuCopy" />
                            <phone:Separator />
                            <phone:MenuItem Header="Delete" />
                        </phone:ContextMenu>
                    </phone:ContextMenuService.ContextMenu>
                    <TextBlock
                        Text="Right-click this panel for a Metro ContextMenu."
                        Style="{StaticResource PhoneTextNormalStyle}"
                        TextWrapping="Wrap" />
                </Border>

                <Button Content="Show CustomMessageBox" Click="OnShowMessage" Margin="0,0,0,16" />

                <TextBlock Text="ApplicationBar and SystemTray" Style="{StaticResource PhoneTextAccentStyle}" />
                <TextBlock
                    Text="Both are API-compatible models. The default frame template does not draw them, so this sample reports their state instead of showing chrome."
                    Style="{StaticResource PhoneTextSubtleStyle}"
                    TextWrapping="Wrap"
                    Margin="0,4,0,8" />
                <TextBlock x:Name="ShellStatus" Style="{StaticResource PhoneTextSubtleStyle}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <Button Content="Toggle application bar" Click="OnToggleApplicationBar" Margin="0,0,0,8" />
                <Button Content="Toggle system tray" Click="OnToggleSystemTray" Margin="0,0,0,16" />

                <Button Content="Go back" Click="OnGoBack" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</phone:PhoneApplicationPage>
