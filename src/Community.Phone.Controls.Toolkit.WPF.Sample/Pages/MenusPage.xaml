<phone:PhoneApplicationPage
    x:Class="PhoneToolkitSample.Pages.MenusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Microsoft.Phone.Controls;assembly=Community.Phone.Controls.Toolkit.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Community.Phone.Controls.Toolkit.WPF"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Community.Phone.Controls.Toolkit.WPF"
    d:DesignHeight="768"
    d:DesignWidth="480"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    mc:Ignorable="d">

    <Grid Background="{StaticResource PhoneBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="12,24,12,12">
            <TextBlock Style="{StaticResource PhoneTextNormalStyle}" Text="Community Phone Toolkit" />
            <TextBlock Style="{StaticResource PhoneTextTitle1Style}" Text="menus and dialogs" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,0,12,24">
                <Border Margin="0,0,0,16" Padding="12" Background="{StaticResource PhoneChromeBrush}">
                    <phone:ContextMenuService.ContextMenu>
                        <phone:ContextMenu>
                            <phone:MenuItem Click="OnContextMenuCopy" Header="Copy" />
                            <phone:Separator />
                            <phone:MenuItem Header="Delete" />
                        </phone:ContextMenu>
                    </phone:ContextMenuService.ContextMenu>
                    <TextBlock Style="{StaticResource PhoneTextNormalStyle}" Text="Right-click this panel for a Metro ContextMenu." TextWrapping="Wrap" />
                </Border>

                <Button
                    Margin="0,0,0,16"
                    HorizontalContentAlignment="Center"
                    Click="OnShowMessage"
                    Content="Show CustomMessageBox" />

                <TextBlock Style="{StaticResource PhoneTextAccentStyle}" Text="ApplicationBar and SystemTray" />
                <TextBlock
                    Margin="0,4,0,8"
                    Style="{StaticResource PhoneTextSubtleStyle}"
                    Text="Both are API-compatible models. The default frame template does not draw them, so this sample reports their state instead of showing chrome."
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="ShellStatus"
                    Margin="0,0,0,8"
                    Style="{StaticResource PhoneTextSubtleStyle}"
                    TextWrapping="Wrap" />
                <Button Margin="0,0,0,8" Click="OnToggleApplicationBar" Content="Toggle application bar" />
                <Button Margin="0,0,0,16" Click="OnToggleSystemTray" Content="Toggle system tray" />

                <Button Click="OnGoBack" Content="Go back" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</phone:PhoneApplicationPage>
