<phone:PhoneApplicationPage
    x:Class="PhoneToolkitSample.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Community.Phone.Controls.Toolkit.WPF"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}">

    <phone:TransitionService.NavigationInTransition>
        <phone:NavigationInTransition>
            <phone:NavigationInTransition.Forward>
                <phone:TurnstileTransition Mode="ForwardIn" />
            </phone:NavigationInTransition.Forward>
            <phone:NavigationInTransition.Backward>
                <phone:TurnstileTransition Mode="BackwardIn" />
            </phone:NavigationInTransition.Backward>
        </phone:NavigationInTransition>
    </phone:TransitionService.NavigationInTransition>

    <phone:TransitionService.NavigationOutTransition>
        <phone:NavigationOutTransition>
            <phone:NavigationOutTransition.Forward>
                <phone:TurnstileTransition Mode="ForwardOut" />
            </phone:NavigationOutTransition.Forward>
            <phone:NavigationOutTransition.Backward>
                <phone:TurnstileTransition Mode="BackwardOut" />
            </phone:NavigationOutTransition.Backward>
        </phone:NavigationOutTransition>
    </phone:TransitionService.NavigationOutTransition>

    <Grid Background="{StaticResource PhoneBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="TitlePanel" Grid.Row="0" Margin="12,24,12,12">
            <TextBlock Style="{StaticResource PhoneTextNormalStyle}" Text="Community Phone Toolkit" />
            <TextBlock Style="{StaticResource PhoneTextTitle1Style}" Text="samples" />
        </StackPanel>

        <ListBox
            x:Name="SampleList"
            Grid.Row="1"
            Margin="12,0,12,0"
            SelectionChanged="OnSampleSelected">
            <ListBoxItem Tag="controls">
                <StackPanel Margin="0,10,0,10">
                    <TextBlock Style="{StaticResource PhoneTextAccentStyle}" Text="Controls" />
                    <TextBlock Style="{StaticResource PhoneTextSubtleStyle}" Text="WPF base controls with WP styling plus the toolkit controls." TextWrapping="Wrap" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="projection">
                <StackPanel Margin="0,10,0,10">
                    <TextBlock Style="{StaticResource PhoneTextAccentStyle}" Text="Projection" />
                    <TextBlock Style="{StaticResource PhoneTextSubtleStyle}" Text="PlaneProjection on real 3D content, animated continuously." TextWrapping="Wrap" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="transitions">
                <StackPanel Margin="0,10,0,10">
                    <TextBlock Style="{StaticResource PhoneTextAccentStyle}" Text="Transitions" />
                    <TextBlock Style="{StaticResource PhoneTextSubtleStyle}" Text="Pick a transition family and navigate with it." TextWrapping="Wrap" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="feather">
                <StackPanel Margin="0,10,0,10">
                    <TextBlock Style="{StaticResource PhoneTextAccentStyle}" Text="Feathering" />
                    <TextBlock Style="{StaticResource PhoneTextSubtleStyle}" Text="TurnstileFeatherEffect staggers the elements of both pages." TextWrapping="Wrap" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="menus">
                <StackPanel Margin="0,10,0,10">
                    <TextBlock Style="{StaticResource PhoneTextAccentStyle}" Text="Menus, dialogs and shell" />
                    <TextBlock Style="{StaticResource PhoneTextSubtleStyle}" Text="ContextMenu, CustomMessageBox, ApplicationBar and SystemTray state." TextWrapping="Wrap" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="CustomMessageBox">
                <StackPanel Margin="0,10,0,10">
                    <TextBlock Style="{StaticResource PhoneTextAccentStyle}" Text="CustomMessageBox" />
                    <TextBlock Style="{StaticResource PhoneTextSubtleStyle}" Text="CustomMessageBox" TextWrapping="Wrap" />
                </StackPanel>
            </ListBoxItem>
        </ListBox>
    </Grid>
</phone:PhoneApplicationPage>
