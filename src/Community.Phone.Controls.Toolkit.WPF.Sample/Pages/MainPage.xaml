<phone:PhoneApplicationPage
    x:Class="PhoneToolkitSample.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Community.Phone.Controls.Toolkit.WPF"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}">

    <phone:TransitionService.NavigationInTransition>
        <phone:NavigationInTransition>
            <phone:NavigationInTransition.Forward>
                <phone:TurnstileTransition Mode="ForwardIn" />
            </phone:NavigationInTransition.Forward>
            <phone:NavigationInTransition.Backward>
                <phone:TurnstileTransition Mode="BackwardIn" />
            </phone:NavigationInTransition.Backward>
        </phone:NavigationInTransition>
    </phone:TransitionService.NavigationInTransition>

    <phone:TransitionService.NavigationOutTransition>
        <phone:NavigationOutTransition>
            <phone:NavigationOutTransition.Forward>
                <phone:TurnstileTransition Mode="ForwardOut" />
            </phone:NavigationOutTransition.Forward>
            <phone:NavigationOutTransition.Backward>
                <phone:TurnstileTransition Mode="BackwardOut" />
            </phone:NavigationOutTransition.Backward>
        </phone:NavigationOutTransition>
    </phone:TransitionService.NavigationOutTransition>

    <Grid Background="{StaticResource PhoneBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="TitlePanel" Grid.Row="0" Margin="12,24,12,12">
            <TextBlock Text="Community Phone Toolkit" Style="{StaticResource PhoneTextNormalStyle}" />
            <TextBlock Text="samples" Style="{StaticResource PhoneTextTitle1Style}" />
        </StackPanel>

        <ListBox
            x:Name="SampleList"
            Grid.Row="1"
            Margin="12,0,12,0"
            SelectionChanged="OnSampleSelected">
            <ListBoxItem Tag="controls">
                <StackPanel Margin="0,10,0,10">
                    <TextBlock Text="Controls" Style="{StaticResource PhoneTextAccentStyle}" />
                    <TextBlock
                        Text="WPF base controls with WP styling plus the toolkit controls."
                        Style="{StaticResource PhoneTextSubtleStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="projection">
                <StackPanel Margin="0,10,0,10">
                    <TextBlock Text="Projection" Style="{StaticResource PhoneTextAccentStyle}" />
                    <TextBlock
                        Text="PlaneProjection on real 3D content, animated continuously."
                        Style="{StaticResource PhoneTextSubtleStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="transitions">
                <StackPanel Margin="0,10,0,10">
                    <TextBlock Text="Transitions" Style="{StaticResource PhoneTextAccentStyle}" />
                    <TextBlock
                        Text="Pick a transition family and navigate with it."
                        Style="{StaticResource PhoneTextSubtleStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="feather">
                <StackPanel Margin="0,10,0,10">
                    <TextBlock Text="Feathering" Style="{StaticResource PhoneTextAccentStyle}" />
                    <TextBlock
                        Text="TurnstileFeatherEffect staggers the elements of both pages."
                        Style="{StaticResource PhoneTextSubtleStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="menus">
                <StackPanel Margin="0,10,0,10">
                    <TextBlock Text="Menus, dialogs and shell" Style="{StaticResource PhoneTextAccentStyle}" />
                    <TextBlock
                        Text="ContextMenu, CustomMessageBox, ApplicationBar and SystemTray state."
                        Style="{StaticResource PhoneTextSubtleStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ListBoxItem>
        </ListBox>
    </Grid>
</phone:PhoneApplicationPage>
