<Application
    x:Class="PhoneToolkitSample.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <sys:String x:Key="ApplicationTitle">WINDOWS PHONE TOOLKIT for WPF</sys:String>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Community.Phone.Controls.Toolkit.WPF;component/Themes/Generic.xaml" />
                <!--<ResourceDictionary Source="/Community.Phone.Controls.Toolkit.WPF;component/Themes/Theme/DarkCobalt.xaml" />-->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
